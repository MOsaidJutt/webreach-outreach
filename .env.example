# ============================================================
# OUTREACH AUTOMATION SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your credentials
# ============================================================

# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=production
DATABASE_URL=sqlite:///outreach.db

# Outscraper API
# Get your key at: https://app.outscraper.com/api-key
OUTSCRAPER_API_KEY=your_outscraper_api_key_here

# Go High Level (GHL)
# Get from: GHL > Settings > Integrations > API
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here
GHL_BASE_URL=https://rest.gohighlevel.com/v1

# GHL v2 API (required for some endpoints)
GHL_CLIENT_ID=your_ghl_client_id_here
GHL_CLIENT_SECRET=your_ghl_client_secret_here
GHL_ACCESS_TOKEN=your_ghl_access_token_here

# OpenAI (for AI conversation response classification)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Webhook Secret (generate a random string and set in GHL webhook config)
WEBHOOK_SECRET=your_webhook_secret_here

# App URL (used for webhook registration)
# Example: https://yourapp.com or http://localhost:5000 for local dev
APP_URL=http://localhost:5000

# SMS Configuration
SMS_FROM_NUMBER=+1xxxxxxxxxx
